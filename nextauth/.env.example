# ─────────────────────────────────────────────────
# NextAuth.js Environment Variables
# Copy this file to .env.local for local development
# or set these in your Docker Compose .env file.
# ─────────────────────────────────────────────────

# REQUIRED — Auth.js secret for signing JWTs and encrypting cookies.
# Generate with: openssl rand -base64 33
AUTH_SECRET="your-random-secret-at-least-32-chars"

# REQUIRED — Tell Auth.js to trust the X-Forwarded-Host header from Caddy.
# Must be true when running behind a reverse proxy.
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────────────
# OAuth Providers — only set the ones you want to enable.
# Auth.js dynamically enables providers based on which env vars are present.
# Start with Google only; add others later by uncommenting + setting values.
# ─────────────────────────────────────────────────

# Google OAuth
# Console: https://console.cloud.google.com/apis/credentials
# Callback URL: https://music.yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth (optional — add later)
# Console: https://developers.facebook.com/apps
# Callback URL: https://music.yourdomain.com/api/auth/callback/facebook
# NOTE: Facebook does NOT support localhost callbacks — use a tunnel for local testing.
# AUTH_FACEBOOK_ID=""
# AUTH_FACEBOOK_SECRET=""

# GitHub OAuth (optional — add later)
# Console: https://github.com/settings/developers
# Callback URL: https://music.yourdomain.com/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
