# ─────────────────────────────────────────────────────────────────────
# Production Caddyfile — NextAuth.js + Navidrome
# ─────────────────────────────────────────────────────────────────────
# Caddy automatically provisions TLS via Let's Encrypt for this domain.
# Replace "music.yourdomain.com" with your actual domain.
# ─────────────────────────────────────────────────────────────────────

music.yourdomain.com {

    # ── Auth.js routes ──────────────────────────────────────────────
    # Proxy all /api/auth/* requests directly to NextAuth.js.
    # This handles: signin page, signout, OAuth callbacks, CSRF, etc.
    # These MUST reach NextAuth.js directly (not via the auth-check sub-request).
    handle /api/auth/* {
        reverse_proxy nextauth:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Subsonic/OpenSubsonic API ───────────────────────────────────
    # These use their own token auth — no reverse-proxy auth needed.
    handle /rest/* {
        reverse_proxy navidrome:4633
    }

    # ── Share links ─────────────────────────────────────────────────
    # Public share URLs — no auth required.
    handle /share/* {
        reverse_proxy navidrome:4633
    }

    # ── Everything else — auth-check then proxy ─────────────────────
    # Uses forward_auth (purpose-built for auth sub-requests):
    #   1. Caddy sub-requests NextAuth.js /api/auth/caddy
    #   2. If 200 → copy Remote-User from auth response into request
    #   3. If not 200 → handle_response injects default guest user
    #   4. Proxy to Navidrome with Remote-User header set
    handle {
        forward_auth nextauth:3000 {
            uri /api/auth/caddy
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
            copy_headers Remote-User

            @unauthed status 4xx 5xx
            handle_response @unauthed {
                # No valid session — inject default guest user (no login wall)
                request_header Remote-User {$DEFAULT_USER:japtaptest}
            }
        }

        reverse_proxy navidrome:4633 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
        }
    }
}