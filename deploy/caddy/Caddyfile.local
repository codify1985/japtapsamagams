# LOCAL TESTING Caddyfile — do NOT use in production.
# Production file: deploy/caddy/Caddyfile
#
# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 (infra test — no OAuth):
#   Serves http://localhost (music) and http://localhost:9000 (Authentik admin).
#   Caddy uses its own port 80. Authentik admin is also directly on host:9000.
#   Test: does japtaptest load? does Caddy routing work? does Authentik UI load?
#
# PHASE 2 (OAuth test — Cloudflare Tunnel):
#   1. Run: cloudflared tunnel --url http://localhost:80
#   2. You get a URL like: https://random-words.trycloudflare.com
#   3. Replace "localhost" below with your tunnel URL (keep https://)
#   4. Add a second block for Authentik if using a named tunnel with auth subdomain
#   5. Register the tunnel URL as the OAuth callback in Google/Facebook console
#   6. docker compose -f deploy/docker-compose-local.yml restart caddy
# ─────────────────────────────────────────────────────────────────────────────

# No global TLS options needed — using http:// for Phase 1
# For Phase 2 with a real tunnel domain, Caddy handles TLS automatically.

# ─────────────────────────────────────────────────
# Navidrome — music player (local)
# Phase 1: http://localhost
# Phase 2: replace with https://your-tunnel.trycloudflare.com
# ─────────────────────────────────────────────────
http://localhost {

    # ── 1. Authentik outpost endpoints ──────────────
    handle /outpost.goauthentik.io/* {
        reverse_proxy authentik-server:9000 {
            header_up Host              {upstream_hostport}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── 2. Subsonic API — bypass auth ───────────────
    handle /rest/* {
        reverse_proxy navidrome:4633 {
            header_up Host              {upstream_hostport}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── 3. Public share links — bypass auth ─────────
    handle /share/* {
        reverse_proxy navidrome:4633 {
            header_up Host              {upstream_hostport}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── 4. All other requests — optional Authentik auth ──
    # Same logic as production: if Authentik has a session → forward real username;
    # if no session (302) → inject Remote-User: japtaptest and allow through.
    handle {
        reverse_proxy authentik-server:9000 {
            method GET
            rewrite /outpost.goauthentik.io/auth/caddy

            header_up X-Original-URL    {scheme}://{host}{uri}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Accept-Encoding   ""

            @authed status 2xx
            handle_response @authed {
                request_header +Remote-User {http.reverse_proxy.header.X-Authentik-Username}

                reverse_proxy navidrome:4633 {
                    header_up Host              {upstream_hostport}
                    header_up X-Real-IP         {remote_host}
                    header_up X-Forwarded-For   {remote_host}
                    header_up X-Forwarded-Proto {scheme}
                    header_up Upgrade    {>Upgrade}
                    header_up Connection {>Connection}
                }
            }

            # No session — use default user (core behaviour being tested)
            handle_response {
                request_header +Remote-User japtaptest

                reverse_proxy navidrome:4633 {
                    header_up Host              {upstream_hostport}
                    header_up X-Real-IP         {remote_host}
                    header_up X-Forwarded-For   {remote_host}
                    header_up X-Forwarded-Proto {scheme}
                    header_up Upgrade    {>Upgrade}
                    header_up Connection {>Connection}
                }
            }
        }
    }
}

# ─────────────────────────────────────────────────
# Authentik admin portal (local)
# NOTE: Authentik is also directly accessible on host port 9000
# (exposed in docker-compose-local.yml) without going through Caddy.
# This block lets you reach it at http://localhost:9001 via Caddy if preferred.
#
# Phase 2 with named tunnel: replace with https://auth.your-tunnel-domain.com
# ─────────────────────────────────────────────────
http://localhost:9001 {
    reverse_proxy authentik-server:9000 {
        header_up Host              {upstream_hostport}
        header_up X-Real-IP         {remote_host}
        header_up X-Forwarded-For   {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
