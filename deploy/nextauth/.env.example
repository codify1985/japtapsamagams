# ─────────────────────────────────────────────────
# NextAuth.js + Navidrome + Caddy — Environment Variables
# Copy this file to .env in the repo root (or same directory as docker-compose.yml).
#
# Usage:
#   docker compose --env-file .env -f deploy/nextauth/docker-compose.yml up -d
# ─────────────────────────────────────────────────

# ── Default Guest User ──────────────────────────
# The username injected by Caddy when no OAuth session exists.
# Must match DefaultUser in navidrome.toml.
DEFAULT_USER=japtaptest

# ── Auth.js Secret ──────────────────────────────
# Required. At least 32 characters. Used to sign JWTs and encrypt cookies.
# Generate with: openssl rand -base64 33
AUTH_SECRET="your-random-secret-at-least-32-chars"

# ── OAuth Providers ─────────────────────────────
# Only set the providers you want to enable.
# Start with Google; add Facebook/GitHub later by uncommenting + setting values.

# Google OAuth
# Console: https://console.cloud.google.com/apis/credentials
# Callback URL: https://music.yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook OAuth (optional — add later)
# Console: https://developers.facebook.com/apps
# Callback URL: https://music.yourdomain.com/api/auth/callback/facebook
# NOTE: Facebook does NOT support localhost callbacks.
# AUTH_FACEBOOK_ID=""
# AUTH_FACEBOOK_SECRET=""

# GitHub OAuth (optional — add later)
# Console: https://github.com/settings/developers
# Callback URL: https://music.yourdomain.com/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
